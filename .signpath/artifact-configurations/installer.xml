<?xml version="1.0" encoding="utf-8"?>
<!-- Paste into SignPath as artifact configuration "installer".
     Input: the GitHub artifact "unsigned-installer" (one Secretarybird-Setup-<version>.exe at the root). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="Secretarybird-Setup-*.exe" min-matches="1" max-matches="1" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
